{
  "name": "pi-extensions",
  "private": true,
  "description": "Pi coding-agent extensions by Tifan",
  "homepage": "https://github.com/tifandotme/pi-extensions#readme",
  "bugs": "https://github.com/tifandotme/pi-extensions/issues",
  "license": "MIT",
  "author": "Tifan Dwi Avianto <hi@tifan.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tifandotme/pi-extensions.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "^24",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typebox": "1.3.17",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
