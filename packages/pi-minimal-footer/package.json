{
  "name": "@tifan/pi-minimal-footer",
  "version": "0.2.0",
  "description": "Minimal footer with model, usage, and project details for Pi.",
  "keywords": [
    "footer",
    "minimal-ui",
    "pi",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/tifandotme/pi-extensions/tree/master/packages/pi-minimal-footer#readme",
  "bugs": "https://github.com/tifandotme/pi-extensions/issues",
  "license": "MIT",
  "author": "Tifan Dwi Avianto <hi@tifan.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tifandotme/pi-extensions.git",
    "directory": "packages/pi-minimal-footer"
  },
