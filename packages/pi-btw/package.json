{
  "name": "@tifan/pi-btw",
  "version": "0.1.0",
  "description": "Ask private side questions about the current pi session.",
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "side-question"
  ],
  "homepage": "https://github.com/tifandotme/pi-extensions/tree/master/packages/pi-btw#readme",
  "bugs": "https://github.com/tifandotme/pi-extensions/issues",
  "license": "MIT",
  "author": "Tifan Dwi Avianto <hi@tifan.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tifandotme/pi-extensions.git",
    "directory": "packages/pi-btw"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --experimental-strip-types --test src/index.test.ts"
  },
